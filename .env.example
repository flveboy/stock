APP_PORT=3000
APP_PASSWORD=请替换为至少8位的访问密码

# 飞牛直接拉取 GitHub 预构建镜像，不需要在 NAS 上构建或安装 Node.js。
APP_IMAGE=ghcr.io/flveboy/stock:nas-docker

# PostgreSQL/Redis 默认使用 Docker Hub；飞牛代理出现 401 时改成 README 中的加速地址。
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine

POSTGRES_DB=stock_ledger
POSTGRES_USER=stock
POSTGRES_PASSWORD=请替换为高强度数据库密码

SESSION_TTL_SECONDS=2592000
TZ=Asia/Shanghai
